*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

/* ---------- Variables de tema (claro por defecto) ---------- */
:root {
    --bg-primary: #eef0f7;
    --blob-1: #f0abfc;
    --blob-2: #c4b5fd;
    --blob-3: #93c5fd;

    --card-bg: #ffffff;
    --card-shadow: rgba(147, 51, 234, 0.18);

    --primary-500: #c026d3;
    --primary-600: #a21caf;
    --primary-400: #e879f9;

    --gradient-primary: linear-gradient(135deg, #ec4899 0%, #c026d3 50%, #9333ea 100%);

    --text-heading: #1e2233;
    --text-subtitle: #64748b;
    --text-label: #33374d;
    --text-placeholder: #9aa0b8;

    --input-bg: #fafafc;
    --input-border: #e6e7f2;

    --toggle-bg: #ffffff;
    --toggle-icon: #6b6f8a;
    --toggle-border: #e6e7f2;

    --alert-bg: #fef1f6;
    --alert-border: #fbcfe8;
    --alert-text: #be185d;

    --radius-card: 30px;
    --radius-input: 12px;
    --radius-btn: 14px;

    --transition-base: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ---------- Variables de tema oscuro ---------- */
[data-theme="dark"] {
    --bg-primary: #0c0b13;
    --blob-1: #86198f;
    --blob-2: #581c87;
    --blob-3: #1e3a5f;

    --card-bg: #17151f;
    --card-shadow: rgba(0, 0, 0, 0.55);

    --text-heading: #f2f2f9;
    --text-subtitle: #94a3b8;
    --text-label: #d6d7e5;
    --text-placeholder: #6c6f85;

    --input-bg: #201d2c;
    --input-border: #322e45;

    --toggle-bg: #201d2c;
    --toggle-icon: #e879f9;
    --toggle-border: #322e45;

    --alert-bg: #2a1522;
    --alert-border: #4a1d38;
    --alert-text: #f472b6;
}

html {
    height: 100%;
    -webkit-text-size-adjust: 100%;
}

body {
    min-height: 100vh;
    min-height: 100dvh;
    font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
    background: var(--bg-primary);
    color: var(--text-heading);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.4s ease, color 0.4s ease;
}

/* ---------- Fondo decorativo (estático y discreto) ---------- */
.bg-decor {
    position: fixed;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
}

.blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.32;
    transition: background-color 0.4s ease;
}

.blob-1 { width: 380px; height: 380px; background: var(--blob-1); top: -120px; left: -110px; }
.blob-2 { width: 320px; height: 320px; background: var(--blob-2); bottom: -110px; right: -90px; }
.blob-3 { width: 240px; height: 240px; background: var(--blob-3); top: 42%; right: 8%; opacity: 0.22; }

/* ---------- Botón de cambio de tema ---------- */
.theme-toggle {
    position: fixed;
    top: calc(24px + env(safe-area-inset-top));
    right: calc(24px + env(safe-area-inset-right));
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--toggle-border);
    background: var(--toggle-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(20, 20, 40, 0.1);
    transition: var(--transition-base);
    z-index: 50;
}

.theme-toggle:hover {
    transform: translateY(-2px) rotate(10deg);
    box-shadow: 0 10px 24px rgba(20, 20, 40, 0.16);
}

.theme-toggle:active { transform: translateY(0) scale(0.94); }

.theme-icon {
    position: absolute;
    width: 22px;
    height: 22px;
    color: var(--toggle-icon);
    transition: opacity 0.45s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.icon-sun { opacity: 1; transform: rotate(0deg) scale(1); }
.icon-moon { opacity: 0; transform: rotate(90deg) scale(0.4); }
[data-theme="dark"] .icon-sun { opacity: 0; transform: rotate(-90deg) scale(0.4); }
[data-theme="dark"] .icon-moon { opacity: 1; transform: rotate(0deg) scale(1); }

/* ---------- Layout principal ---------- */
.login-wrapper {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.login-card {
    width: 100%;
    max-width: 440px;
    padding: 2px;
    border-radius: var(--radius-card);
    background: var(--gradient-primary);
    box-shadow: 0 24px 60px -12px var(--card-shadow);
    animation: cardEntrance 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}

.login-card-inner {
    background: var(--card-bg);
    border-radius: calc(var(--radius-card) - 2px);
    padding: 44px 40px 40px;
    transition: background-color 0.4s ease;
}

@keyframes cardEntrance {
    from { opacity: 0; transform: translateY(28px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

/* ---------- Logo: contenedor vacío para uso manual ---------- */
.logo-container {
    display: flex;
    justify-content: center;
    margin-bottom: 24px;
}

.logo-placeholder {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    border: 2px dashed var(--primary-400);
    background: linear-gradient(135deg, rgba(192, 38, 211, 0.05), rgba(147, 51, 234, 0.05));
    transition: var(--transition-base);
}

/* Clase lista para usar cuando agregues tu <img> dentro del contenedor */
.logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}

/* ---------- Encabezados ---------- */
.login-title {
    font-family: 'Poppins', 'Inter', sans-serif;
    font-size: 22px;
    font-weight: 700;
    text-align: center;
    color: var(--text-heading);
    margin-bottom: 6px;
}

.login-subtitle {
    font-size: 13.5px;
    text-align: center;
    color: var(--text-subtitle);
    margin-bottom: 28px;
}

/* ---------- Alerta de error (oculta por defecto) ---------- */
.alert-banner {
    align-items: center;
    gap: 10px;
    background: var(--alert-bg);
    border: 1px solid var(--alert-border);
    color: var(--alert-text);
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 13px;
    margin-bottom: 20px;
    animation: fadeIn 0.35s ease;
}

.alert-banner svg { width: 18px; height: 18px; flex-shrink: 0; }

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
}

/* ---------- Formulario ---------- */
.form-group { margin-bottom: 18px; }

.form-group label {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-label);
    margin-bottom: 8px;
    transition: color 0.25s ease;
}

.form-group:focus-within label { color: var(--primary-500); }

.input-wrapper { position: relative; }

.input-wrapper input {
    width: 100%;
    padding: 14px 16px;
    font-size: 14.5px;
    font-family: inherit;
    color: var(--text-heading);
    background: var(--input-bg);
    border: 1.5px solid var(--input-border);
    border-radius: var(--radius-input);
    outline: none;
    transition: var(--transition-base);
}

.input-wrapper.has-icon input { padding-right: 46px; }
.input-wrapper input::placeholder { color: var(--text-placeholder); }
.input-wrapper input:hover { border-color: var(--primary-400); }

.input-wrapper input:focus {
    border-color: var(--primary-500);
    background: var(--card-bg);
    box-shadow: 0 0 0 4px rgba(192, 38, 211, 0.13);
}

/* Corrige el fondo azul/amarillo que imponen los navegadores en autocompletado */
.input-wrapper input:-webkit-autofill,
.input-wrapper input:-webkit-autofill:hover,
.input-wrapper input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--text-heading);
    -webkit-box-shadow: 0 0 0 1000px var(--input-bg) inset;
    transition: background-color 9999s ease-in-out 0s;
}

.toggle-password {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    border: none;
    background: transparent;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text-placeholder);
    transition: var(--transition-base);
}

.toggle-password:hover { background: rgba(192, 38, 211, 0.08); color: var(--primary-500); }

.eye-icon {
    position: absolute;
    width: 19px;
    height: 19px;
    transition: opacity 0.2s ease, transform 0.2s ease;
}

.eye-open { opacity: 1; transform: scale(1); }
.eye-closed { opacity: 0; transform: scale(0.6); }
.toggle-password.is-visible .eye-open { opacity: 0; transform: scale(0.6); }
.toggle-password.is-visible .eye-closed { opacity: 1; transform: scale(1); }

/* ---------- Botón de ingreso ---------- */
.btn-login {
    position: relative;
    width: 100%;
    margin-top: 8px;
    padding: 15px;
    border: none;
    border-radius: var(--radius-btn);
    background: var(--gradient-primary);
    background-size: 200% auto;
    color: #fff;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 24px -6px rgba(192, 38, 211, 0.5);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-position 0.6s ease;
}

.btn-login:hover {
    transform: translateY(-2px);
    background-position: right center;
    box-shadow: 0 14px 30px -6px rgba(192, 38, 211, 0.55);
}

.btn-login:active { transform: translateY(0) scale(0.98); }
.btn-login:disabled { cursor: not-allowed; opacity: 0.85; }

.btn-loader {
    display: none;
    width: 18px;
    height: 18px;
    border: 2.5px solid rgba(255, 255, 255, 0.4);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
}

.btn-login.is-loading .btn-text { visibility: hidden; position: absolute; }
.btn-login.is-loading .btn-loader { display: inline-block; }

@keyframes spin { to { transform: rotate(360deg); } }

/* Efecto ripple al hacer clic en el botón */
.ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.55);
    transform: scale(0);
    animation: rippleAnim 0.6s ease-out;
    pointer-events: none;
}

@keyframes rippleAnim { to { transform: scale(2.6); opacity: 0; } }

/* ---------- Accesibilidad: foco visible por teclado ---------- */
button:focus-visible,
input:focus-visible {
    outline: 2px solid var(--primary-500);
    outline-offset: 2px;
}

/* ---------- Responsive ---------- */
@media (max-width: 480px) {
    .login-wrapper { padding: 16px; }
    .login-card-inner { padding: 36px 24px 32px; }
    .login-title { font-size: 19px; }
    .logo-placeholder { width: 88px; height: 88px; }
    .theme-toggle {
        width: 42px; height: 42px;
        top: calc(16px + env(safe-area-inset-top));
        right: calc(16px + env(safe-area-inset-right));
    }
    .theme-icon { width: 19px; height: 19px; }
    .blob { filter: blur(60px); }
}

@media (min-width: 481px) and (max-width: 768px) {
    .login-card { max-width: 400px; }
}

@media (min-width: 1200px) {
    .login-card { max-width: 460px; }
    .login-card-inner { padding: 52px 48px 46px; }
}

/* Pantallas bajas (ej. móvil en horizontal) */
@media (max-height: 560px) {
    .login-wrapper { align-items: flex-start; padding-top: 32px; padding-bottom: 32px; }
    .logo-container { margin-bottom: 14px; }
    .logo-placeholder { width: 70px; height: 70px; }
    .login-subtitle { margin-bottom: 18px; }
}

/* ---------- Respeta la preferencia de movimiento reducido ---------- */
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}